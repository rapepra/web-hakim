# Reforma Elegant3 (reformaelegante.es) — Hostinger (LiteSpeed/Apache)

# Una sola URL canónica: https://reformaelegante.es (sin www)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://reformaelegante.es/$1 [L,R=301]

  # /index.html -> / (evita contenido duplicado)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Archivos de trabajo que no deben publicarse
  RewriteRule ^(nuevas\ imagenes|imagenes|imagenes_seleccionadas)(/|$) - [R=404,L,NC]
  RewriteRule \.(py|md|sh)$ - [R=404,L,NC]
</IfModule>

ErrorDocument 404 /404.html

# Compresión de texto
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Tipos modernos y acentos correctos en los .txt para IAs
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddCharset utf-8 .txt .xml .css .js
</IfModule>

# Caché: imágenes 30 días, fuentes 1 año, CSS/JS 7 días, HTML siempre al día
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
